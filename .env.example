# Copy this file to .env and replace the placeholder values. Never commit .env.
# See docs/LOCAL_SETUP.md for what each setting does and what happens if it is missing.

# ---- Required ----
DATABASE_URL=postgresql+psycopg://smarthire_user:change_me@localhost:5432/smarthire
# Secret used to sign login tokens (minimum 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use a different value in every environment. Without it, sign-in returns HTTP 503.
SMART_HIRE_AUTH_SECRET=

# ---- Optional ----
# Where uploaded resumes are stored. Blank = the per-user application data directory.
SMART_HIRE_RESUME_STORAGE_ROOT=
# Days before a stored resume is eligible for automatic deletion (0 = no time limit; the consent
# expiry, if sooner, still applies). The default of 180 is a placeholder, not legal advice.
SMART_HIRE_RESUME_RETENTION_DAYS=180
# Set to "production" to make the server refuse to start with unsafe settings.
SMART_HIRE_ENV=

# ---- Developer shortcut for API tools only (leave off) ----
# The web app always requires sign-in. When true, direct localhost API calls without a token
# are treated as this recruiter. Never enable in a deployed environment.
SMART_HIRE_DEVELOPMENT_MODE=false
SMART_HIRE_DEVELOPMENT_RECRUITER_ID=
