# Copy this file to .env and replace the local development values.
# Do not commit .env or use this placeholder in a deployed environment.
# Optional private storage location; blank uses the per-user application data directory.
SMART_HIRE_RESUME_STORAGE_ROOT=
# Enable only for local development; resume APIs also require a loopback client.
SMART_HIRE_DEVELOPMENT_MODE=false
# UUID of an existing active local development recruiter.
SMART_HIRE_DEVELOPMENT_RECRUITER_ID=
DATABASE_URL=postgresql+psycopg://smarthire_user:change_me@localhost:5432/smarthire
